# Patent Research Hub environment variables. Names only: put real values in your shell profile, your MCP
# client's "env" block, or a copy of this file named .env that you never commit and load with
# `node --env-file=.env src/cli.mjs ...` (the Hub itself does not read .env files). Every key is optional; a
# source without its key reports "not_configured" with its registration link. Check with `node src/cli.mjs doctor`.

# --- Provider credentials (direct transport) ---
# USPTO Open Data Portal: patent file wrapper search, PTAB trials/appeals, documents and originals.
#   Register: https://data.uspto.gov/apis/getting-started
USPTO_API_KEY=

# EPO Open Patent Services: consumer key and secret of your OPS application (OAuth client credentials).
#   Register: https://developers.epo.org/user/register
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
# Optional alternative: a short-lived OPS access token you obtained yourself (expires in about 20 minutes).
EPO_ACCESS_TOKEN=

# GovInfo API (api.data.gov key). Register: https://www.govinfo.gov/api-signup
GOVINFO_API_KEY=

# CourtListener API token. Also requires courtlistenerEnabled and courtlistenerInternalUseAllowed in
# config.json after reading https://free.law/membership/allowed-api-usage/
COURTLISTENER_TOKEN=

# Google BigQuery: path to a service-account JSON key or an `gcloud auth application-default login`
# credential file, and your own Google Cloud project ID. Dry runs are free byte estimates; data queries
# stay disabled until enabled in config.json. See docs/BIGQUERY_SETUP.md before enabling.
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT_ID=

# --- Locations and options ---
# PATENT_RESEARCH_CONFIG=         # path to config.json (default: <install>/config.json)
# PATENT_RESEARCH_DATA_DIR=       # default: <install>/data
# PATENT_RESEARCH_EXPORTS_DIR=    # default: <install>/exports
# PATENT_RESEARCH_TRANSPORT=      # direct (default) or n8n
# RESEARCH_PYTHON=                # absolute path to Python 3 (charts need matplotlib)
# RESEARCH_PLOT_PYTHON=           # Python for charts only (overrides RESEARCH_PYTHON)

# --- Optional integrations ---
# RESEARCH_GET_FILES_CLIENT=      # path to the Get Files tool's get-files-client.mjs
# RESEARCH_CORPUS_CLIENT=         # path to a corpus client module (PatentsView intake)
# RESEARCH_GATEWAY_AUTH_FILE=     # n8n transport only: file holding the local gateway bearer value
