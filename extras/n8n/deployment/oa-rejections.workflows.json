        "name": "Package Rejections Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          100,
          0
        ],
        "parameters": {
          "jsCode": "const pack=function packageRejectionsResponse(j){\n const body=j&&typeof j==='object'&&!Array.isArray(j)?j:null;\n if(!body)return {text:JSON.stringify({provider_status:null,provider_message:'unrecognized provider response'}),status:502,contentType:'application/json'};\n const code=Number(body.code??body.status);\n // Success needs a documented shape: records {response:{...}} or the field list {fields:[...]}. Anything else (provider error objects, or a non-JSON page that\n // n8n wraps as {data:'<html>...'}) is an error, never a 200.\n const looksError=(Number.isInteger(code)&&code>=400)||!((body.response&&typeof body.response==='object'&&!Array.isArray(body.response))||Array.isArray(body.fields));\n if(!looksError)return {text:JSON.stringify(body),status:200,contentType:'application/json'};\n const message=['message','detailedMessage','errorDetails','error','data'].map(k=>body[k]).filter(v=>typeof v==='string').join(' | ').replace(/[\\u0000-\\u001f]/g,' ').slice(0,300);\n return {text:JSON.stringify({provider_status:Number.isInteger(code)?code:null,provider_message:message}),status:Number.isInteger(code)&&code>=400&&code<600?code:502,contentType:'application/json'};\n};return [{json:pack($input.first().json)}];"
        }
