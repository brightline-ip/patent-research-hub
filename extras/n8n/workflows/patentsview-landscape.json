{
  "id": "patent-research-patentsview-landscape",
  "name": "Patent Research — PatentsView local landscape (editable form and callable tool)",
  "description": "Read-only local annualized PatentsView landscape query through the existing authenticated batch bridge.",
  "active": false,
  "nodes": [
    {
      "id": "pv-landscape-call",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -700,
        180
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "pv-landscape-form",
      "name": "Patent landscape form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -700,
        -100
      ],
      "parameters": {
        "authentication": "n8nUserAuth",
        "requireExecuteAccess": true,
        "formTitle": "PatentsView local patent landscape",
        "formDescription": "Query the installed annual PatentsView snapshot. Counts are distinct granted patents within documented snapshot coverage.",
        "formFields": {
          "values": [
            {
              "fieldName": "assignee",
              "fieldLabel": "Assignee name contains",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldName": "inventor",
              "fieldLabel": "Inventor name contains",
              "fieldType": "text",
              "requiredField": false
            },
            {
              "fieldName": "cpcSection",
              "fieldLabel": "CPC section",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": ""
                  },
                  {
                    "option": "A"
                  },
                  {
                    "option": "B"
                  },
                  {
                    "option": "C"
                  },
                  {
                    "option": "D"
                  },
                  {
                    "option": "E"
                  },
                  {
                    "option": "F"
                  },
                  {
                    "option": "G"
                  },
                  {
                    "option": "H"
                  },
                  {
                    "option": "Y"
                  }
                ]
              },
              "requiredField": false
            },
            {
              "fieldName": "wipoField",
              "fieldLabel": "WIPO technology field ID (1–35)",
              "fieldType": "number",
              "requiredField": false
            },
            {
              "fieldName": "limit",
              "fieldLabel": "Maximum patent records (1–100)",
              "fieldType": "number",
              "defaultValue": 25,
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "pv-landscape-validate",
      "name": "Validate named landscape filters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        20
      ],
      "parameters": {
        "jsCode": "const raw=$input.first().json.body??$input.first().json,output={};\nfor(const field of ['assignee','inventor']){const value=String(raw[field]??'').trim();if(value){if(value.length>200)throw new Error(field+' is too long');output[field]=value;}}\nconst cpc=String(raw.cpcSection??'').trim().toUpperCase();if(cpc){if(!/^[A-HY]$/.test(cpc))throw new Error('CPC section must be one of A through H or Y');output.cpcSection=cpc;}\nconst wipo=String(raw.wipoField??'').trim();if(wipo){if(!/^(?:[1-9]|[12]\\d|3[0-5])$/.test(wipo))throw new Error('WIPO field must be 1 through 35');output.wipoField=String(Number(wipo));}\nconst limit=Number(raw.limit??25);if(!Number.isInteger(limit)||limit<1||limit>100)throw new Error('Limit must be 1 through 100');output.limit=limit;\nif(!output.assignee&&!output.inventor&&!output.cpcSection&&!output.wipoField)throw new Error('Enter at least one landscape filter');return [{json:output}];"
      }
    },
    {
      "id": "pv-landscape-request",
      "name": "Query local PatentsView snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "https://host.docker.internal:8780/api/v1/operations/runtime/patentsview/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "provideSslCertificates": true
      },
      "credentials": {
        "httpSslAuth": {
          "id": "REPLACE_WITH_TLS_CREDENTIAL_ID",
          "name": "Batch coordinator client identity"
        }
      }
    },
    {
      "id": "pv-landscape-result",
      "name": "Present distinct patent landscape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        20
      ],
      "parameters": {
        "jsCode": "const value=$input.first().json;if(!value||!Array.isArray(value.records)||!Number.isSafeInteger(value.total_distinct_patents)||value.returned!==value.records.length)throw new Error('Local landscape response is invalid');return [{json:{snapshot_id:value.snapshot_id,total_distinct_patents:value.total_distinct_patents,returned:value.returned,records:value.records,coverage:value.coverage,warning:value.warning,interpretation:'Counts are distinct granted patents in the installed snapshot and selected filters; they are not family counts, ownership opinions, or complete current legal-status results.'}}];"
      }
    },
    {
      "id": "pv-landscape-branch",
      "name": "Was submitted from the form",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "pv-form-executed",
              "leftValue": "={{ $('Patent landscape form').isExecuted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "pv-landscape-form-result",
      "name": "Build safe form result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -80
      ],
      "parameters": {
        "jsCode": "const value=$input.first().json,escape=value=>String(value??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\nconst records=value.records.slice(0,100).map((record,index)=>{const inventors=(record.inventors??[]).map(item=>item.name||item.id).filter(Boolean).join(', ')||'Not listed';const tech=[...(record.cpc_sections??[]),...(record.first_wipo_field_title?[record.first_wipo_field_title]:[]),...(record.first_wipo_sector_title?[record.first_wipo_sector_title]:[])].join(', ')||'Not classified';return (index+1)+'. '+escape(record.patent_number)+' — '+escape((record.assignee_names??[]).join(', ')||'No assignee listed')+' — Inventors: '+escape(inventors)+' — Technology: '+escape(tech);});\nconst coverage=typeof value.coverage==='string'?value.coverage:JSON.stringify(value.coverage??{});const lines=['Distinct granted patents: '+escape(value.total_distinct_patents),'Records shown: '+escape(value.returned),'Coverage: '+escape(coverage),...records];if(value.warning)lines.push('Warning: '+escape(value.warning));return [{json:{formSubmittedText:lines.join('\\n')}}];"
      }
    },
    {
      "id": "pv-landscape-form-respond",
      "name": "Show landscape results in form",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        960,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "pv-landscape-call-result",
      "name": "Return landscape JSON to caller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        130
      ],
      "parameters": {
        "jsCode": "return $input.all();"
      }
    }
  ],
  "connections": {
    "Patent landscape form": {
      "main": [
        [
          {
            "node": "Validate named landscape filters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When Called by Another Workflow": {
      "main": [
        [
          {
            "node": "Validate named landscape filters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate named landscape filters": {
      "main": [
        [
          {
            "node": "Query local PatentsView snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query local PatentsView snapshot": {
      "main": [
        [
          {
            "node": "Present distinct patent landscape",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Present distinct patent landscape": {
      "main": [
        [
          {
            "node": "Was submitted from the form",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Was submitted from the form": {
      "main": [
        [
          {
            "node": "Build safe form result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return landscape JSON to caller",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build safe form result": {
      "main": [
        [
          {
            "node": "Show landscape results in form",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "7fcb0e25-8205-4e83-92eb-f3ea9ef8b534"
}
