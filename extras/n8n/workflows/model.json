      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ],
      "parameters": {
        "jsCode": "const j=$input.first().json,b=j.body; if(!b||!Array.isArray(b.messages)||JSON.stringify(b).length>1800000)throw new Error('Invalid or oversized chat request'); const allowed=j.allowedModels.split(',').map(s=>s.trim()); const model=b.model||j.defaultModel;if(!allowed.includes(model))throw new Error('Model not enabled in Connection Settings');const keys=['messages','tools','tool_choice','parallel_tool_calls','temperature','top_p','max_completion_tokens','reasoning_effort','response_format','stop','seed'];const request={model,stream:false,store:false};for(const k of keys)if(b[k]!==undefined)request[k]=b[k];if(b.max_tokens!==undefined&&!request.max_completion_tokens)request.max_completion_tokens=b.max_tokens;return [{json:{request}}];"
      }
    },
